---
import { site } from '../data/site';
import Icon from './Icon.astro';
const { cta, contact } = site;
---
<section class="cta-wrap" id="contacto" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta">
      <span class="c c--1" aria-hidden="true"></span>
      <span class="c c--2" aria-hidden="true"></span>
      <span class="c c--3" aria-hidden="true"></span>
      <p class="eyebrow">{cta.eyebrow}</p>
      <h2 id="cta-title">{cta.title}</h2>
      <p class="cta__lead">{cta.lead}</p>
      <a class="btn btn--lg" href={contact.whatsapp} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={22} /> {cta.primary} <Icon name="arrow" size={22} />
      </a>
      <a class="cta__ig" href={contact.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={18} /> {cta.secondary}</a>
    </div>
  </div>
</section>

<style>
  .cta-wrap { background: var(--bg); padding-bottom: clamp(3rem, 6vw, 4.5rem); }
  .cta { position: relative; overflow: hidden; background: var(--bg-2); border-radius: 20px; text-align: center; padding: clamp(2.5rem, 6vw, 3.5rem) 1.5rem; display: flex; flex-direction: column; align-items: center; }
  .cta > :not(.c) { position: relative; }
  .c { position: absolute; border-radius: 50%; background: var(--blob); }
  .c--1 { width: 16rem; aspect-ratio: 1; left: -8rem; top: 2rem; opacity: .7; }
  .c--2 { width: 5rem; aspect-ratio: 1; left: 4.5rem; bottom: 1rem; background: #cddbef; }
  .c--3 { width: 13rem; aspect-ratio: 1; right: -3rem; top: -4rem; opacity: .8; }
  h2 { font-size: clamp(2.4rem, 5vw, 3.4rem); margin: 0 0 .8rem; }
  .cta__lead { color: var(--muted); font-size: 1.05rem; margin-bottom: 1.6rem; }
  @media (max-width: 480px) { .btn--lg { font-size: .95rem; padding: .95rem 1.4rem; gap: .5rem; } }
  .cta__ig { display: inline-flex; align-items: center; gap: .5rem; font-size: .85rem; margin-top: 1.2rem; text-decoration: none; }
  .cta__ig:hover { text-decoration: underline; }
</style>
