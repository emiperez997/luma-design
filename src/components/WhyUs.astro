---
import { site } from '../data/site';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
const { why } = site;
---
<section class="section why" aria-labelledby="why-title">
  <span class="blob blob--a" aria-hidden="true"></span>
  <span class="blob blob--b" aria-hidden="true"></span>
  <span class="blob blob--c" aria-hidden="true"></span>
  <div class="container">
    <SectionHeading number="03" title={why.title} lead={why.lead} tone="dark" id="why-title" />
    <ul class="why__grid">
      {why.items.map((it) => (
        <li>
          <Icon name={it.icon} size={34} stroke={1.3} />
          <h3>{it.title}</h3>
          <p>{it.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .why { background: var(--navy); color: #fff; overflow: hidden; }
  .blob { position: absolute; border-radius: 50%; pointer-events: none; }
  .blob--a { width: 20rem; aspect-ratio: 1; right: -4rem; top: -9rem; background: #243559; }
  .blob--b { width: 12rem; aspect-ratio: 1; right: -5rem; top: 2.5rem; background: #2e4474; }
  .blob--c { width: 11rem; aspect-ratio: 1; left: -6rem; bottom: -5rem; background: #2c4170; }
  .why .container { position: relative; }
  .why__grid { list-style: none; padding: 0 0 0 4.2rem; margin: 2.6rem 0 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  .why__grid li { max-width: 15rem; }
  .why h3 { font-family: var(--font-sans); font-size: 1rem; font-weight: 600; margin: 1.1rem 0 .6rem; }
  .why p { color: #c2cbdd; font-size: .9rem; margin: 0; }
  @media (max-width: 900px) { .why__grid { grid-template-columns: repeat(2, 1fr); padding-left: 0; } }
  @media (max-width: 480px) { .why__grid { grid-template-columns: 1fr; } }
</style>
