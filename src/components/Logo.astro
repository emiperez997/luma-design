---
import { site } from "../data/site";
interface Props {
  size?: "md" | "lg";
}
const { size = "md" } = Astro.props;
---

<a
  href="#inicio"
  class:list={["logo", `logo--${size}`]}
  aria-label={`${site.name}, ir al inicio`}
>
  <img class="logo__mark" src="/logo.svg" alt="" aria-hidden="true" />
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--ink);
  }
  .logo__mark {
    width: 2.4rem;
    height: 2.4rem;
    flex: none;
  }
  .logo--lg .logo__mark {
    width: 2.9rem;
    height: 2.9rem;
  }
  .logo__text {
    display: grid;
    line-height: 1.05;
  }
  .logo__name {
    font-family: var(--font-serif);
    font-size: 1.12rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .logo__tag {
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 0.2rem;
  }
</style>
