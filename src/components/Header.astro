---
import { site } from '../data/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
---
<header class="header">
  <div class="container header__inner">
    <Logo />
    <nav class="nav" id="nav" aria-label="Principal">
      <ul>
        {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
      <a class="btn btn--sm" href="#contacto">Contactanos <Icon name="arrow" size={18} /></a>
    </nav>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav">
      <span class="sr-only">Abrir menú</span>
      <Icon name="menu" class="i-open" />
      <Icon name="close" class="i-close" />
    </button>
  </div>
</header>

<script>
  const header = document.querySelector('.header')!;
  const toggle = header.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const setOpen = (open: boolean) => {
    header.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
  };
  toggle.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
  header.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .header { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(10px); transition: box-shadow .2s; }
  .header.is-scrolled { box-shadow: 0 1px 0 var(--line); }
  .header__inner { display: flex; align-items: center; justify-content: space-between; min-height: 4.5rem; }
  .nav { display: flex; align-items: center; gap: 2.5rem; }
  .nav ul { display: flex; gap: 2.2rem; list-style: none; margin: 0; padding: 0; }
  .nav ul a { text-decoration: none; font-size: .88rem; color: var(--muted); }
  .nav ul a:hover { color: var(--ink); }
  .nav ul li:first-child a { color: var(--ink); font-weight: 500; }
  .menu-toggle { display: none; background: none; border: 0; color: var(--ink); padding: .4rem; cursor: pointer; }
  :global(.i-close) { display: none; }

  @media (max-width: 860px) {
    .menu-toggle { display: block; }
    .nav { position: absolute; inset: 100% 0 auto; flex-direction: column; align-items: stretch; gap: 1.2rem; padding: 1.2rem var(--pad) 1.6rem; background: var(--bg); border-bottom: 1px solid var(--line); display: none; }
    .nav ul { flex-direction: column; gap: 1rem; }
    .nav ul a { font-size: 1rem; }
    .nav .btn { justify-content: center; }
    .is-open .nav { display: flex; }
    .is-open :global(.i-open) { display: none; } .is-open :global(.i-close) { display: block; }
  }
</style>
