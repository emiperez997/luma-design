---
import { site } from '../data/site';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import Mockup from './mockups/Mockup.astro';
const { works } = site;
---
<section class="section works" id="trabajos" aria-labelledby="works-title">
  <div class="container">
    <div class="works__head">
      <SectionHeading number="04" title={works.title} lead={works.lead} id="works-title" />
      <a class="btn btn--sm" href={site.contact.instagram} target="_blank" rel="noopener">{works.moreLabel} <Icon name="arrow" size={18} /></a>
    </div>

    <div class="carousel" data-carousel>
      <button class="carousel__btn carousel__btn--prev" type="button" data-prev aria-label="Trabajo anterior"><Icon name="chevron-left" /></button>
      <ul class="carousel__track" data-track tabindex="0" aria-label="Trabajos">
        {works.items.map((w) => (
          <li class="work">
            <div class="work__media">
              {w.image ? <img src={w.image} alt={`${w.title} — ${w.meta}`} loading="lazy" /> : <div class="work__mockup"><Mockup kind={w.mockup ?? 'laptop'} /></div>}
            </div>
            <div class="work__body">
              <h3>{w.title}</h3>
              <p>{w.meta}</p>
            </div>
          </li>
        ))}
      </ul>
      <button class="carousel__btn carousel__btn--next" type="button" data-next aria-label="Trabajo siguiente"><Icon name="chevron-right" /></button>
      <div class="carousel__dots" data-dots></div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const dotsWrap = root.querySelector<HTMLElement>('[data-dots]')!;
    const items = Array.from(track.children) as HTMLElement[];
    const step = () => items[1] ? items[1].offsetLeft - items[0].offsetLeft : track.clientWidth;

    const dots = items.map((_, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.setAttribute('aria-label', `Ir al trabajo ${i + 1}`);
      b.addEventListener('click', () => track.scrollTo({ left: step() * i, behavior: 'smooth' }));
      dotsWrap.append(b);
      return b;
    });

    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      const idx = track.scrollLeft >= max - 4 ? items.length - 1 : Math.round(track.scrollLeft / step());
      dots.forEach((d, i) => d.toggleAttribute('aria-current', i === idx));
    };

    root.querySelector('[data-prev]')!.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    root.querySelector('[data-next]')!.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') track.scrollBy({ left: step(), behavior: 'smooth' });
      if (e.key === 'ArrowLeft') track.scrollBy({ left: -step(), behavior: 'smooth' });
    });
    update();
  });
</script>

<style>
  .works { background: var(--bg-2); }
  .works__head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1.5rem; margin-bottom: 2rem; }
  .works__head .btn { margin-top: .4rem; flex: none; }
  .carousel { position: relative; }
  .carousel__track { list-style: none; margin: 0; padding: 0 0 .5rem; display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 3 * 1rem) / 4); gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .carousel__track::-webkit-scrollbar { display: none; }
  .work { scroll-snap-align: start; background: var(--surface); border-radius: var(--radius); overflow: hidden; box-shadow: 0 8px 24px -18px rgba(28, 43, 75, .25); }
  .work__media { aspect-ratio: 4 / 3.3; background: #dfe7f3; display: grid; place-items: center; overflow: hidden; }
  .work__media img { width: 100%; height: 100%; object-fit: cover; }
  .work__mockup { font-size: clamp(7px, 1.1vw, 13px); display: grid; place-items: center; }
  .work__mockup :global(.laptop) { width: 20em; }
  .work__body { padding: .9rem 1rem 1.1rem; }
  .work h3 { font-family: var(--font-sans); font-size: .9rem; margin: 0 0 .2rem; }
  .work p { font-size: .75rem; color: var(--muted); margin: 0; }
  .carousel__btn { position: absolute; top: calc(50% - 1.8rem); translate: 0 -50%; z-index: 2; width: 2.8rem; height: 2.8rem; border-radius: 50%; border: 0; background: #fff; color: var(--ink); display: grid; place-items: center; cursor: pointer; box-shadow: 0 6px 18px -8px rgba(28, 43, 75, .4); }
  .carousel__btn--prev { left: -1.4rem; } .carousel__btn--next { right: -1.4rem; }
  .carousel__dots { display: flex; justify-content: center; gap: .5rem; margin-top: 1.5rem; }
  .carousel__dots :global(button) { width: .55rem; height: .55rem; border-radius: 50%; border: 0; padding: 0; background: #b7c5dc; cursor: pointer; }
  .carousel__dots :global(button[aria-current]) { background: var(--navy); }
  @media (max-width: 980px) { .carousel__track { grid-auto-columns: calc((100% - 1rem) / 2); } .work__mockup { font-size: clamp(7px, 1.8vw, 12px); } }
  @media (max-width: 560px) {
    .carousel__track { grid-auto-columns: 82%; }
    .work__mockup { font-size: 3vw; }
    .carousel__btn { display: none; }
    .works__head { flex-direction: column; }
  }
</style>
