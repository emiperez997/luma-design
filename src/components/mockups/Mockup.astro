---
import type { MockupKind } from '../../data/site';
import CvSheet from './CvSheet.astro';
import Laptop from './Laptop.astro';
import Flyer from './Flyer.astro';
import Phone from './Phone.astro';
interface Props { kind: MockupKind }
const { kind } = Astro.props;
---
{kind === 'cv' && <CvSheet />}
{kind === 'laptop' && <Laptop />}
{kind === 'flyer' && <Flyer />}
{kind === 'phone' && <Phone />}
